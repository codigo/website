# Docker Compose Configuration (for local development)
NETWORK_DRIVER=bridge
CADDY_NET_EXTERNAL=false
REPLICAS=1
DEBUG=true

# PocketBase Paths (local development)
PB_DATA_PATH=./pb/pb_data
PB_MIGRATIONS_PATH=./pb/pb_migrations

# Public Environment Variables
PUBLIC_POCKETBASE_URL=http://pocketbase:8090
PUBLIC_CF_TURNSTILE_KEY=your_turnstile_key_here
PUBLIC_LOG_LEVEL=debug
PUBLIC_APP_ENV=development

# Private Environment Variables (Never commit these!)
# Get these from 1Password CLI or your secrets manager
SECRET_OPENAI_API_KEY=your_openai_api_key_here
SECRET_CF_TURNSTILE_SECRET=your_turnstile_secret_here
SECRET_POCKETBASE_ADMIN_EMAIL=admin@example.com
SECRET_POCKETBASE_ADMIN_PASSWORD=your_admin_password_here
